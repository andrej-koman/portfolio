---
interface Props { ratio: string; placeholder: string; src?: string; alt?: string }
const { ratio, placeholder, src, alt = '' } = Astro.props;
---
<div style={`position:relative;width:100%;aspect-ratio:${ratio}`}>
  <div class="image-slot">
    {src ? <img src={src} alt={alt} loading="lazy" /> : <span>{placeholder}</span>}
  </div>
</div>
