---
interface Props { images: string[]; alt: string; placeholder: string }
const { images, alt, placeholder } = Astro.props;
const many = images.length > 1;
---
{images.length === 0 ? (
  <div style="aspect-ratio:16/10"><div class="image-slot"><span>{placeholder}</span></div></div>
) : (
  <div class="carousel" data-carousel>
    <div class="carousel-track" tabindex="0" aria-label={alt}>
      {images.map((src, i) => (
        <div class="carousel-slide"><img src={src} alt={`${alt} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} /></div>
      ))}
    </div>
    {many && (
      <div class="carousel-bar">
        <button type="button" data-dir="-1" aria-label="Previous image">←</button>
        <span data-count>1 / {images.length}</span>
        <button type="button" data-dir="1" aria-label="Next image">→</button>
      </div>
    )}
  </div>
)}
<script>
  const init = () => document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const track = root.querySelector<HTMLElement>('.carousel-track')!;
    const count = root.querySelector<HTMLElement>('[data-count]');
    const total = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + total) % total) * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    track.addEventListener('scroll', () => { if (count) count.textContent = `${index() + 1} / ${total}`; }, { passive: true });
    root.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((b) => b.addEventListener('click', () => go(index() + Number(b.dataset.dir))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });
  });
  init();
  document.addEventListener('astro:page-load', init);
</script>
<style is:global>
  .carousel{display:flex;flex-direction:column;gap:12px}
  .carousel-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:10px;border:1px solid var(--line);background:var(--line)}
  .carousel-track::-webkit-scrollbar{display:none}
  .carousel-slide{flex:0 0 100%;scroll-snap-align:center;display:flex;align-items:center;justify-content:center}
  .carousel-slide img{display:block;width:100%;height:auto;max-height:80vh;object-fit:contain}
  .carousel-bar{display:flex;align-items:center;justify-content:center;gap:16px;font-family:var(--mono);font-size:12px;color:var(--subtle)}
  .carousel-bar button{font:inherit;font-size:14px;color:var(--fg);background:none;border:1px solid var(--line2);border-radius:6px;padding:4px 12px;cursor:pointer;transition:color .15s,border-color .15s}
  .carousel-bar button:hover{color:var(--accent);border-color:var(--accent)}
</style>
