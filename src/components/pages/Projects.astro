---
import Base from '../../layouts/Base.astro';
import TechChip from '../TechChip.astro';
import { PROJECTS, localize, type Locale } from '../../data/projects';
import { t, href } from '../../data/i18n';

const { lang } = Astro.props as { lang: Locale };
const tr = t(lang);
const projects = PROJECTS.map(p => localize(p, lang));
---
<Base lang={lang} path="projects">
  <section class="stack-56">
    <div data-anim style="display:flex;flex-direction:column;gap:12px">
      <p style="margin:0;color:var(--muted);max-width:520px;text-wrap:pretty">{tr.heroSub}</p>
    </div>
    <div class="stack-16">
      <div data-anim class="mono-label" style="display:flex;justify-content:space-between"><span class="section-label">{tr.projectsLabel}</span><span>{String(projects.length).padStart(2, '0')}</span></div>
      <div style="display:flex;flex-direction:column;border-top:1px solid var(--line)">
        {projects.map(p => (
          <a data-anim data-row style="--dir:1" class="project-row" href={href(lang, `projects/${p.slug}`)}>
            <span class="mono-label" style="padding-top:3px">{p.year}</span>
            <span style="display:flex;flex-direction:column;gap:6px;min-width:0">
              <span data-vt={p.slug} style={`view-transition-name:title-${p.slug};font-weight:500;color:var(--fg);align-self:flex-start`}>{p.name}</span>
              <span style="color:var(--muted);font-size:14px;text-wrap:pretty">{p.desc}</span>
              <span style="display:flex;flex-wrap:wrap;gap:4px 14px">{p.tech.map(s => <TechChip {...s} variant="muted" />)}</span>
            </span>
            <span data-arrow style="font-family:var(--mono);color:var(--accent);padding-top:1px">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
