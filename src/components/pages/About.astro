---
import Base from '../../layouts/Base.astro';
import TechChip from '../TechChip.astro';
import { ABOUT_STACK, tech, type Locale } from '../../data/projects';
import { t } from '../../data/i18n';

const { lang } = Astro.props as { lang: Locale };
const tr = t(lang);
const stack = ABOUT_STACK.map(g => ({ label: tr.stackGroups[g.key], items: g.items.map(tech) }));
const QUOTE_WORDS = 40;
// Splits a quote into paragraphs, keeping the first QUOTE_WORDS words visible.
const excerpt = (quote: string) => {
  let left = QUOTE_WORDS;
  return quote.split('\n\n').map(par => {
    const words = par.split(' ');
    const head = words.slice(0, Math.max(left, 0)).join(' ');
    const rest = words.slice(Math.max(left, 0)).join(' ');
    left -= words.length;
    return { head, rest, hidden: !head };
  });
};
const timeline = [
  { label: tr.eduLabel, rows: tr.edu },
  { label: tr.expLabel, rows: tr.exp },
];
---
<Base lang={lang} path="about" title={`${tr.aboutTitle} — Andrej Koman`} description={tr.aboutDesc}>
  <section class="stack-56">
    <div data-anim class="stack-16">
      <p style="margin:0;max-width:560px;text-wrap:pretty">{tr.aboutP1}</p>
      <p style="margin:0;max-width:560px;text-wrap:pretty">{tr.aboutP2}</p>
      <a href="/cv.pdf" download class="btn-outline">{tr.cv}<span style="font-family:var(--mono);font-size:12px;color:var(--accent)">↓</span></a>
    </div>
    {timeline.map(block => (
      <div data-anim class="stack-16">
        <span class="section-label">{block.label}</span>
        <div style="display:flex;flex-direction:column;border-top:1px solid var(--line)">
          {block.rows.map(([years, role, company]) => (
            <div style="display:grid;grid-template-columns:150px minmax(0,1fr);gap:16px;padding:14px 0;border-bottom:1px solid var(--line)">
              <span class="mono-label" style="padding-top:2px">{years}</span>
              <span style="display:flex;flex-direction:column"><span style="color:var(--fg);font-weight:500">{role}</span><span style="color:var(--muted);font-size:14px">{company}</span></span>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div data-anim class="stack-16">
      <span class="section-label">{tr.stackLabel}</span>
      <div style="display:flex;flex-direction:column;border-top:1px solid var(--line)">
        {stack.map(g => (
          <div style="display:grid;grid-template-columns:minmax(96px,150px) minmax(0,1fr);gap:12px;padding:14px 0;border-bottom:1px solid var(--line)">
            <span class="mono-label" style="padding-top:2px">{g.label}</span>
            <div style="display:flex;flex-wrap:wrap;gap:6px 20px;padding-top:2px">{g.items.map(s => <TechChip {...s} />)}</div>
          </div>
        ))}
      </div>
    </div>
    <div data-anim class="stack-16">
      <span class="section-label">{tr.testLabel}</span>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
        {tr.tests.map(([quote, name, role]) => (
          <figure style="margin:0;display:flex;flex-direction:column;justify-content:space-between;gap:20px;padding:20px;border:1px solid var(--line2);border-radius:10px">
            <blockquote style="margin:0;color:var(--fg);font-size:15px;text-wrap:pretty;display:flex;flex-direction:column;gap:12px">
              {excerpt(quote).map(({ head, rest, hidden }) => hidden
                ? <p style="margin:0" data-rest hidden>{rest}</p>
                : <p style="margin:0">{head}{rest && <><span data-dots>…</span><span data-rest hidden>{' '}{rest}</span></>}</p>
              )}
            </blockquote>
            {quote.split(/\s+/).length > QUOTE_WORDS && <button class="quote-toggle" data-quote-toggle aria-expanded="false" data-more={tr.more} data-less={tr.less}>{tr.more}</button>}
            <figcaption style="display:flex;flex-direction:column;font-size:13px"><span style="color:var(--fg);font-weight:500">{name}</span><span style="font-family:var(--mono);font-size:11.5px;color:var(--subtle)">{role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
