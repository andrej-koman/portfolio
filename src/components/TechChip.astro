---
interface Props { name: string; mask: string; variant?: 'plain' | 'chip' | 'muted' }
const { name, mask, variant = 'plain' } = Astro.props;
const tone = variant === 'muted' ? 'var(--subtle)' : 'var(--fg)';
const icon = `width:${variant === 'muted' ? 12 : 14}px;height:${variant === 'muted' ? 12 : 14}px;background:${tone};-webkit-mask:${mask};mask:${mask}`;
---
{variant === 'chip' ? (
  <span class="chip"><span style={icon}></span>{name}</span>
) : (
  <span title={name} style={`display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:${variant === 'muted' ? 11.5 : 12}px;color:${tone}`}><span style={icon}></span>{name}</span>
)}
